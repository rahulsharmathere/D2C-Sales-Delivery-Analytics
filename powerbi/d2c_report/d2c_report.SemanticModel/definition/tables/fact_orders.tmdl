table fact_orders
	lineageTag: a1000005-0001-0001-0001-000000000001

	column order_id
		dataType: string
		lineageTag: b1000005-0001-0001-0001-000000000001
		summarizeBy: none
		sourceColumn: order_id

	column order_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: b1000005-0001-0001-0001-000000000002
		summarizeBy: none
		sourceColumn: order_date

	column customer_id
		dataType: string
		lineageTag: b1000005-0001-0001-0001-000000000003
		summarizeBy: none
		sourceColumn: customer_id

	column product_id
		dataType: string
		lineageTag: b1000005-0001-0001-0001-000000000004
		summarizeBy: none
		sourceColumn: product_id

	column quantity
		dataType: int64
		formatString: #,0
		lineageTag: b1000005-0001-0001-0001-000000000005
		summarizeBy: sum
		sourceColumn: quantity

	column discount_pct
		dataType: double
		formatString: 0.0%
		lineageTag: b1000005-0001-0001-0001-000000000006
		summarizeBy: none
		sourceColumn: discount_pct

	column selling_price
		dataType: double
		formatString: ₹#,0
		lineageTag: b1000005-0001-0001-0001-000000000007
		summarizeBy: sum
		sourceColumn: selling_price

	column shipping_cost
		dataType: double
		formatString: ₹#,0
		lineageTag: b1000005-0001-0001-0001-000000000008
		summarizeBy: sum
		sourceColumn: shipping_cost

	column payment_method
		dataType: string
		lineageTag: b1000005-0001-0001-0001-000000000009
		summarizeBy: none
		sourceColumn: payment_method

	column order_status
		dataType: string
		lineageTag: b1000005-0001-0001-0001-0000000010
		summarizeBy: none
		sourceColumn: order_status

	column warehouse
		dataType: string
		lineageTag: b1000005-0001-0001-0001-0000000011
		summarizeBy: none
		sourceColumn: warehouse

	column promised_days
		dataType: int64
		formatString: 0
		lineageTag: b1000005-0001-0001-0001-0000000012
		summarizeBy: average
		sourceColumn: promised_days

	column actual_days
		dataType: double
		formatString: 0.0
		lineageTag: b1000005-0001-0001-0001-0000000013
		summarizeBy: average
		sourceColumn: actual_days

	column discount_band = SWITCH(TRUE(), fact_orders[discount_pct] <= 0.10, "0-10%", fact_orders[discount_pct] <= 0.20, "10-20%", fact_orders[discount_pct] <= 0.30, "20-30%", "30%+")
		dataType: string
		lineageTag: b1000005-0001-0001-0001-000000000014
		summarizeBy: none

	partition fact_orders = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents("C:\Users\rahul\OneDrive\Desktop\powerBiProject\data\processed\fact_orders.csv"),[Delimiter=",", Columns=13, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"order_id", type text}, {"order_date", type date}, {"customer_id", type text}, {"product_id", type text}, {"quantity", Int64.Type}, {"discount_pct", type number}, {"selling_price", type number}, {"shipping_cost", type number}, {"payment_method", type text}, {"order_status", type text}, {"warehouse", type text}, {"promised_days", Int64.Type}, {"actual_days", type number}})
			in
				#"Changed Type"
