{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "bar_category_margin_comparison",
  "position": {
    "x": 20,
    "y": 250,
    "width": 920,
    "height": 390,
    "z": 1000
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Source": "dim_products"
                    }
                  },
                  "Property": "category"
                }
              },
              "queryRef": "dim_products.category"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Source": "_Measures"
                    }
                  },
                  "Property": "Gross Margin %"
                }
              },
              "queryRef": "_Measures.Gross Margin %"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Source": "_Measures"
                    }
                  },
                  "Property": "Contribution Margin %"
                }
              },
              "queryRef": "_Measures.Contribution Margin %"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Category Margin Diagnostics: Gross Margin % vs Contribution Margin % (Freight Drag)'"
                }
              }
            }
          }
        }
      ]
    }
  }
}