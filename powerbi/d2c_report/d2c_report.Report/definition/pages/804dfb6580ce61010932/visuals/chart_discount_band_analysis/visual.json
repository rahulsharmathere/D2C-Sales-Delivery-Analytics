{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "chart_discount_band_analysis",
  "position": {
    "x": 960,
    "y": 250,
    "width": 940,
    "height": 390,
    "z": 1000
  },
  "visual": {
    "visualType": "lineClusteredColumnComboChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Source": "fact_orders"
                    }
                  },
                  "Property": "discount_band"
                }
              },
              "queryRef": "fact_orders.discount_band"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Source": "_Measures"
                    }
                  },
                  "Property": "Gross Revenue"
                }
              },
              "queryRef": "_Measures.Gross Revenue"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Source": "_Measures"
                    }
                  },
                  "Property": "Contribution Profit"
                }
              },
              "queryRef": "_Measures.Contribution Profit"
            }
          ]
        },
        "Y2": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Source": "_Measures"
                    }
                  },
                  "Property": "Contribution Margin %"
                }
              },
              "queryRef": "_Measures.Contribution Margin %"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Discount Depth Impact: Gross Revenue, Contribution Profit & Net Margin %'"
                }
              }
            }
          }
        }
      ]
    }
  }
}