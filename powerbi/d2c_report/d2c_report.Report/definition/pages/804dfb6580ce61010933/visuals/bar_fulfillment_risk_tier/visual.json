{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "bar_fulfillment_risk_tier",
  "position": {
    "x": 970,
    "y": 250,
    "width": 930,
    "height": 390,
    "z": 1000
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Source": "dim_customers"
                    }
                  },
                  "Property": "city_tier"
                }
              },
              "queryRef": "dim_customers.city_tier"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Source": "_Measures"
                    }
                  },
                  "Property": "Order Failure Rate %"
                }
              },
              "queryRef": "_Measures.Order Failure Rate %"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Source": "_Measures"
                    }
                  },
                  "Property": "Return Rate %"
                }
              },
              "queryRef": "_Measures.Return Rate %"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Source": "_Measures"
                    }
                  },
                  "Property": "Cancellation Rate %"
                }
              },
              "queryRef": "_Measures.Cancellation Rate %"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Fulfillment Failure Breakdown: Order Failure %, Return % & Cancel % by City Tier'"
                }
              }
            }
          }
        }
      ]
    }
  }
}