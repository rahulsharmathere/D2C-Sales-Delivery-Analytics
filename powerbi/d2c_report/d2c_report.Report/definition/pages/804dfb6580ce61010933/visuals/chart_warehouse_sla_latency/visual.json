{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "chart_warehouse_sla_latency",
  "position": {
    "x": 20,
    "y": 250,
    "width": 930,
    "height": 390,
    "z": 1000
  },
  "visual": {
    "visualType": "lineClusteredColumnComboChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Source": "fact_orders"
                    }
                  },
                  "Property": "warehouse"
                }
              },
              "queryRef": "fact_orders.warehouse"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Source": "_Measures"
                    }
                  },
                  "Property": "On-Time Delivery %"
                }
              },
              "queryRef": "_Measures.On-Time Delivery %"
            }
          ]
        },
        "Y2": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Source": "_Measures"
                    }
                  },
                  "Property": "Average Transit Days"
                }
              },
              "queryRef": "_Measures.Average Transit Days"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Warehouse SLA Performance: On-Time Delivery % (Bars) vs Avg Transit Days (Line) - Kolkata Fails at 61.6%'"
                }
              }
            }
          }
        }
      ]
    }
  }
}