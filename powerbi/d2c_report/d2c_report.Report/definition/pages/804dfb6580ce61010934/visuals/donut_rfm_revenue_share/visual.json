                }
              },
              "queryRef": "customer_rfm.rfm_segment"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Source": "_Measures"
                    }
                  },
                  "Property": "Gross Revenue"
                }
              },
              "queryRef": "_Measures.Gross Revenue"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'RFM Segment Revenue Concentration: Champions Drive 77.0% of Cumulative Brand Revenue'"
                }
              }
            }
          }
        }
      ]
