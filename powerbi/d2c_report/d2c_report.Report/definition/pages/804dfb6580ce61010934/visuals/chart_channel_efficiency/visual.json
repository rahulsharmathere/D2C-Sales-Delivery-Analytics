{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "chart_channel_efficiency",
  "position": {
    "x": 20,
    "y": 250,
    "width": 930,
    "height": 390,
    "z": 1000
  },
  "visual": {
    "visualType": "lineClusteredColumnComboChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Source": "dim_channel"
                    }
                  },
                  "Property": "channel_name"
                }
              },
              "queryRef": "dim_channel.channel_name"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Source": "_Measures"
                    }
                  },
                  "Property": "Total Marketing Spend"
                }
              },
              "queryRef": "_Measures.Total Marketing Spend"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Source": "_Measures"
                    }
                  },
                  "Property": "Gross Revenue"
                }
              },
              "queryRef": "_Measures.Gross Revenue"
            }
          ]
        },
        "Y2": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Source": "_Measures"
                    }
                  },
                  "Property": "ROAS"
                }
              },
              "queryRef": "_Measures.ROAS"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Acquisition Channel Efficiency: Spend & Revenue (Bars) vs Paid ROAS (Line) - Google 10.16x vs IG 3.22x'"
                }
              }
            }
          }
        }
      ]
    }
  }
}