{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "chart_monthly_trajectory",
  "position": {
    "x": 20,
    "y": 250,
    "width": 1220,
    "height": 390,
    "z": 1000
  },
  "visual": {
    "visualType": "lineClusteredColumnComboChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Source": "dim_date"
                    }
                  },
                  "Property": "month_year"
                }
              },
              "queryRef": "dim_date.month_year"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Source": "_Measures"
                    }
                  },
                  "Property": "Gross Revenue"
                }
              },
              "queryRef": "_Measures.Gross Revenue"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Source": "_Measures"
                    }
                  },
                  "Property": "Net Delivered Revenue"
                }
              },
              "queryRef": "_Measures.Net Delivered Revenue"
            }
          ]
        },
        "Y2": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Source": "_Measures"
                    }
                  },
                  "Property": "Gross Margin %"
                }
              },
              "queryRef": "_Measures.Gross Margin %"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Monthly Revenue Trajectory & Gross Margin Dilution (Festive Q4 Drops)'"
                }
              }
            }
          }
        }
      ]
    }
  }
}